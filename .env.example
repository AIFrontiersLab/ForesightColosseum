# ============================================
# GENERAL
# ============================================
PREDICTION_ENV=development
LOG_LEVEL=INFO
TZ=America/Los_Angeles

# ============================================
# PREDICTION TOURNAMENT
# ============================================
PREDICTION_TOURNAMENT_ENABLED=true
PREDICTION_TOURNAMENT_CONFIG=config/tournament.yaml
PREDICTION_TOURNAMENT_OUTPUT_DIR=outputs/prediction_tournament
PREDICTION_TOURNAMENT_DATA_DIR=data/prediction_tournament
PREDICTION_TOURNAMENT_DB=data/prediction_tournament/tournament.db

# ============================================
# LLM (Ollama default; OpenAI optional)
# ============================================
PREDICTION_LLM_PROVIDER=ollama
PREDICTION_LLM_MODEL=qwen3.6:27b
PREDICTION_LLM_BASE_URL=http://127.0.0.1:11434/v1
PREDICTION_LLM_TEMPERATURE=0.4
PREDICTION_LLM_TIMEOUT_SECONDS=300
PREDICTION_LLM_MAX_RETRIES=2
OPENAI_API_KEY=

# Optional WhatsApp delivery (reuse Hermes env if set)
WHATSAPP_ENABLED=false
WHATSAPP_GROUP_ID=

# Confidence calibration weights (must sum to 1.0)
CALIBRATION_WEIGHT_FORECASTER=0.50
CALIBRATION_WEIGHT_CHALLENGER=0.20
CALIBRATION_WEIGHT_JUDGE=0.30

# Consensus clustering
CONSENSUS_SIMILARITY_THRESHOLD=0.72
